# Optional. Copy to .env to bake defaults into your own IPK build.
# Normally you don't need this: set the TV up from the app's setup screen
# (open "HA PIP" from the TV's app list) or from the Home Assistant integration.
#
# Never publish an IPK built with a token in it.

# Home Assistant base URL as seen from the TV (no trailing slash)
HA_URL=

# Long-lived access token (HA profile -> Security -> Long-lived access tokens)
HA_TOKEN=

# Default camera entity, e.g. camera.front_door
HA_CAMERA=

# mjpeg | snapshot | hls | webrtc
HA_MODE=

# top-right | top-left | bottom-right | bottom-left
HA_POSITION=

# PIP width in percent of the screen width
HA_SIZE=

# Seconds until the PIP closes itself (0 = stays until closed)
HA_TIMEOUT=
